#!/usr/bin/env python3
"""rice-media — «сейчас играет» для waybar (отдельный процесс вместо встроенного mpris,
который иногда роняет весь бар). Слушает `playerctl --follow`, печатает JSON."""
import json, subprocess, sys, time

IGNORE = "%any,!firefox"
SEP = "\x1f"
FMT = SEP.join(["{{status}}", "{{title}}", "{{artist}}", "{{album}}", "{{playerName}}"])
ICONS = {"Playing": "\U0000F001", "Paused": "\U0000F04C", "Stopped": "\U0000F04D"}
MAXLEN = 38


def emit(obj):
    print(json.dumps(obj, ensure_ascii=False), flush=True)


def line_to_json(line):
    parts = line.rstrip("\n").split(SEP)
    if len(parts) < 5 or not parts[0]:
        return {"text": "", "class": "none"}
    status, title, artist, album, player = parts[:5]
    text = f"{title} — {artist}" if artist else title
    if len(text) > MAXLEN:
        text = text[: MAXLEN - 1] + "…"
    text = text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    icon = ICONS.get(status, ICONS["Stopped"])
    if status == "Paused":
        text = f"<i>{text}</i>"
    return {"text": f"{icon} {text}", "class": status.lower(),
            "tooltip": f"{player}: {title}\n{artist}" + (f" · {album}" if album else "")}


while True:
    emit({"text": "", "class": "none"})
    try:
        p = subprocess.Popen(["playerctl", "-p", IGNORE, "--follow", "metadata", "--format", FMT],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        for line in p.stdout:
            emit(line_to_json(line))
        p.wait()
    except Exception:
        pass
    time.sleep(2)  # плеер закрылся или playerctl упал — ждём и пробуем снова
