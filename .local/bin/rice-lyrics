#!/usr/bin/env python3
"""rice-lyrics — синхронный текст текущей песни (для lo-fi панели).

Берёт трек из плеера (playerctl, кроме Firefox), ищет текст с таймкодами на lrclib.net,
показывает текущую строку (яркая) и следующую (бледная). Нет синхронного текста — пусто.
Тексты кэшируются локально в ~/.cache/rice/lyrics (только для показа, в git не попадают).
Для отладки: rice-lyrics --status  (печатает, найден ли текст, но не сам текст)."""
import curses, hashlib, json, os, re, subprocess, sys, time, urllib.parse, urllib.request

CACHE = os.path.expanduser("~/.cache/rice/lyrics")
UA = "rice-lyrics/1.0 (personal desktop widget)"
PLAYER = "%any,!firefox"
SEP = "\x1f"


def meta():
    r = subprocess.run(["playerctl", "-p", PLAYER, "metadata", "--format",
                        SEP.join(["{{status}}", "{{title}}", "{{artist}}", "{{album}}", "{{mpris:length}}", "{{position}}"])],
                       capture_output=True, text=True)
    p = r.stdout.rstrip("\n").split(SEP)
    if r.returncode or len(p) < 6 or not p[1]:
        return None
    status, title, artist, album, length, pos = p
    return {"status": status, "title": title, "artist": artist.split(",")[0].strip(), "album": album,
            "length": int(length or 0) / 1e6, "pos": int(pos or 0) / 1e6}


def parse_lrc(text):
    out = []
    for line in (text or "").splitlines():
        stamps = re.findall(r"\[(\d+):(\d+(?:\.\d+)?)\]", line)
        words = re.sub(r"\[[^\]]*\]", "", line).strip()
        for m, s in stamps:
            out.append((int(m) * 60 + float(s), words))
    return sorted(out)


def fetch(m):
    key = hashlib.sha1(f'{m["artist"]}|{m["title"]}'.lower().encode()).hexdigest()
    path = os.path.join(CACHE, key + ".json")
    if os.path.exists(path):
        return json.load(open(path)).get("synced")
    def get(url):
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=6) as r:
            return json.loads(r.read().decode())
    synced = None
    try:
        q = {"track_name": m["title"], "artist_name": m["artist"]}
        if m["album"]: q["album_name"] = m["album"]
        if m["length"]: q["duration"] = str(round(m["length"]))
        try:
            synced = get("https://lrclib.net/api/get?" + urllib.parse.urlencode(q)).get("syncedLyrics")
        except Exception:
            pass
        if not synced:
            res = get("https://lrclib.net/api/search?" + urllib.parse.urlencode(
                {"track_name": m["title"], "artist_name": m["artist"]}))
            synced = next((x.get("syncedLyrics") for x in res if x.get("syncedLyrics")), None)
    except Exception:
        return None                      # сеть недоступна — не кэшируем, попробуем позже
    os.makedirs(CACHE, exist_ok=True)
    json.dump({"synced": synced}, open(path, "w"))
    return synced


def status():
    m = meta()
    if not m:
        return print("плеер: ничего не играет")
    lines = parse_lrc(fetch(m))
    print(f"трек: {m['artist']} — {m['title']} | {m['status']} | синхронный текст: "
          f"{'найден, строк ' + str(len(lines)) if lines else 'нет'}")


def ui(scr):
    curses.curs_set(0); curses.use_default_colors(); scr.nodelay(True)
    curses.init_pair(1, 15, -1)   # текущая строка — цвет темы (color15)
    curses.init_pair(2, 7, -1)    # следующая — второй цвет темы
    track, lines, last_fetch = None, [], 0
    while True:
        m = meta()
        cur, nxt = "", ""
        if m:
            tid = (m["artist"], m["title"])
            if tid != track or (not lines and time.time() - last_fetch > 30):
                track, last_fetch = tid, time.time()
                lines = parse_lrc(fetch(m))
            if lines:
                i = max((k for k, (t, _) in enumerate(lines) if t <= m["pos"] + 0.15), default=-1)
                cur = lines[i][1] if i >= 0 else ""
                nxt = lines[i + 1][1] if i + 1 < len(lines) else ""
        h, w = scr.getmaxyx()
        scr.erase()
        top = max(0, h // 2 - 1)
        for row, (txt, pair, attr) in enumerate([(cur, 1, curses.A_BOLD), (nxt, 2, curses.A_DIM)]):
            txt = txt[: max(0, w - 2)]
            if txt:
                try: scr.addstr(top + row * 2, 1, txt, curses.color_pair(pair) | attr)
                except curses.error: pass
        scr.refresh()
        try:
            if scr.getkey() in ("q", "Q"): return
        except curses.error:
            pass
        time.sleep(0.25)


if __name__ == "__main__":
    if "--status" in sys.argv:
        status()
    else:
        try: curses.wrapper(ui)
        except KeyboardInterrupt: pass
